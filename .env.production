# Production environment template. Copy to .env and replace every placeholder.
ENVIRONMENT=production
OPENAI_API_KEY=sk-your-openai-api-key
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# PostgreSQL container credentials
POSTGRES_DB=liquidroute
POSTGRES_USER=liquidroute
POSTGRES_PASSWORD=replace-with-a-strong-random-password
