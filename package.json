{
  "name": "local-life-agent-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4174",
    "dev:backend": "uv run uvicorn backend.api.app:app --host 127.0.0.1 --port 8787",
    "build": "next build",
    "start": "HOSTNAME=0.0.0.0 PORT=4174 node .next/standalone/server.js",
    "test": "npm run typecheck && npm run test:backend",
    "test:backend": "uv run pytest tests/backend -q -p no:cacheprovider",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test tests/e2e"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
