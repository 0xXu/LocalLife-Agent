{
  "name": "weekendpilot-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4174",
    "dev:backend": "uv run uvicorn backend.api.app:app --host 127.0.0.1 --port 8787",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4174",
    "test": "npm run test:frontend && npm run test:backend",
    "test:backend": "uv run pytest tests/backend -q",
    "test:contracts": "tsx --test tests/contracts/*.test.ts",
    "test:frontend": "tsx --test tests/frontend/*.test.ts tests/frontend/*.test.tsx",
    "test:e2e": "playwright test tests/e2e",
    "test:all": "npm run test:contracts && npm run test:frontend && npm run test:backend"
  },
  "dependencies": {
    "@types/node": "^25.6.2",
    "lucide-react": "^0.468.0",
    "mapbox-gl": "^3.23.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/jsdom": "^28.0.1",
    "@types/react": "^19.2.14",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1"
  }
}
