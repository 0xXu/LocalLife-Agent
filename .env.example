# OpenAI-compatible LLM provider for WeekendPilot backend.
# Copy this file to .env and fill in your real key locally.

NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

LLM_PROVIDER=mimo
LLM_API_PROTOCOL=openai
LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
LLM_API_KEY=replace-with-your-dedicated-api-key
LLM_MODEL=mimo-v2.5-pro

# Optional Anthropic-compatible endpoint from the same plan.
ANTHROPIC_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic

# Generation defaults.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_REMOTE_ENABLED=false
