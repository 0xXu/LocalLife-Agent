# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key

# JWT signing secret (at least 32 characters in production)
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL async connection URL
DATABASE_URL=postgresql+asyncpg://liquidroute:liquidroute@localhost:5433/liquidroute

# 高德地图 Web API Key
GAODE_API_KEY=your-gaode-key

# 美团开放平台 API Token
MEITUAN_API_TOKEN=your-meituan-token
